apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  name: {{ inventory_hostname }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ k8s_installation__cluster_name }}
kubernetesVersion: {{ k8s_version }}
networking:
  podSubnet: "{{ k8s_installation__pod_cidr }}"
  serviceSubnet: "{{ k8s_installation__service_cidr }}"
apiServer:
  certSANs:
  - 127.0.0.1
  - "{{ private_ip }}"
  - "{{ public_ip }}"
  extraArgs:
  - name: bind-address
    value: "0.0.0.0"
controllerManager:
  extraArgs:
  - name: bind-address
    value: "0.0.0.0"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd